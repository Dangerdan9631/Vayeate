        "colors": [
            {
                "id": "vayeate.markdownHeading1Foreground",
                "description": "Foreground color for Markdown level 1 headings.",
                "defaults": { "dark": "editor.foreground", "light": "editor.foreground", "highContrast": "editor.foreground", "highContrastLight": "editor.foreground" }
            },
            {
                "id": "vayeate.markdownHeading2Foreground",
                "description": "Foreground color for Markdown level 2 headings.",
                "defaults": { "dark": "editor.foreground", "light": "editor.foreground", "highContrast": "editor.foreground", "highContrastLight": "editor.foreground" }
            },
            {
                "id": "vayeate.markdownHeading3Foreground",
                "description": "Foreground color for Markdown level 3 headings.",
                "defaults": { "dark": "editor.foreground", "light": "editor.foreground", "highContrast": "editor.foreground", "highContrastLight": "editor.foreground" }
            },
            {
                "id": "vayeate.markdownHeading4Foreground",
                "description": "Foreground color for Markdown level 4 headings.",
